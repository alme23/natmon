package components

templ AddDeviceModal() {
	<div x-show="showAddDeviceModal"
		 x-cloak
		 class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
		 x-on:click.self="showAddDeviceModal = false">
		<div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
			<div class="mt-3">
				<div class="flex justify-between items-center mb-4">
					<h3 class="text-lg font-medium text-gray-900">Добавить устройство</h3>
					<button x-on:click="showAddDeviceModal = false" class="text-gray-400 hover:text-gray-600">
						<img src="/static/icons/close.svg" class="w-6 h-6" alt="Закрыть"/>
					</button>
				</div>

				<form x-on:submit.prevent="addDevice($event)">
					<div class="mb-4">
						<label class="block text-sm font-medium text-gray-700 mb-2">IP адрес *</label>
						<input type="text" name="ip_address" required
							   placeholder="192.168.1.100"
							   pattern="^(\d{1,3}\.){3}\d{1,3}$"
							   title="Введите корректный IP адрес"
							   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"/>
					</div>

					<div class="mb-4">
						<label class="block text-sm font-medium text-gray-700 mb-2">SNMP Port</label>
						<input type="number" name="snmp_port" value="161"
							   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"/>
					</div>

					<div class="mb-4">
						<label class="block text-sm font-medium text-gray-700 mb-2">Community</label>
						<input type="text" name="snmp_community" value="private"
							   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"/>
					</div>

					<div class="flex justify-end space-x-3">
						<button type="button" x-on:click="showAddDeviceModal = false"
								class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
							Отмена
						</button>
						<button type="submit"
								class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">
							Добавить
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}

templ DeviceDetailsModal() {
	<div x-show="showDeviceDetailsModal"
		 x-cloak
		 class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
		 x-on:click.self="showDeviceDetailsModal = false">
		<div class="relative top-10 mx-auto p-5 border w-[600px] shadow-lg rounded-md bg-white">
			<div id="deviceDetailsModalContent">
				<!-- Детали устройства загружаются через JavaScript -->
			</div>
		</div>
	</div>
}

templ EditDeviceModal() {
	<div x-show="showEditDeviceModal"
		 x-cloak
		 class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50"
		 x-on:click.self="showEditDeviceModal = false">
		<div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
			<div class="mt-3">
				<div class="flex justify-between items-center mb-4">
					<h3 class="text-lg font-medium text-gray-900">Редактировать устройство</h3>
					<button x-on:click="showEditDeviceModal = false" class="text-gray-400 hover:text-gray-600">
						<img src="/static/icons/close.svg" class="w-6 h-6" alt="Закрыть"/>
					</button>
				</div>

				<form x-on:submit.prevent="updateDevice($event)">
					<div class="mb-4">
						<label class="block text-sm font-medium text-gray-700 mb-2">IP адрес *</label>
						<input type="text" name="ip_address" x-model="editingDevice.ip_address" required
							   placeholder="192.168.1.100"
							   pattern="^(\d{1,3}\.){3}\d{1,3}$"
							   title="Введите корректный IP адрес"
							   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"/>
					</div>

					<div class="mb-4">
						<label class="block text-sm font-medium text-gray-700 mb-2">SNMP Port</label>
						<input type="number" name="snmp_port" x-model="editingDevice.snmp_port"
							   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"/>
					</div>

					<div class="mb-4">
						<label class="block text-sm font-medium text-gray-700 mb-2">Community</label>
						<input type="text" name="snmp_community" x-model="editingDevice.snmp_community"
							   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"/>
					</div>

					<div class="flex justify-end space-x-3">
						<button type="button" x-on:click="showEditDeviceModal = false"
								class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
							Отмена
						</button>
						<button type="submit"
								class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700">
							Сохранить
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
