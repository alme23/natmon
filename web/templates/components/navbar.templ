package components

templ Navbar() {
	<nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-10">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between h-16">
				<div class="flex items-center">
					<img src="/static/icons/device.svg" class="w-8 h-8 text-blue-600 mr-3" alt="NATMon"/>
					<h1 class="text-xl font-semibold text-gray-800">NATMon</h1>
				</div>
			</div>
		</div>
	</nav>
}
