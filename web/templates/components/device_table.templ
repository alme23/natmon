package components

import (
	"fmt"
	"github.com/alme23/natmon/internal/model"
	"github.com/alme23/natmon/internal/presenter"
)

templ DeviceTable(devices []model.Device) {
	<div id="devicesTable" class="overflow-x-auto">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50 sticky top-0">
				<tr>
					<th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">IP</th>
					<th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">MAC</th>
					<th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Имя</th>
					<th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">Локация</th>
					<th class="px-3 py-2 text-center text-xs font-medium text-gray-500 uppercase">К1</th>
					<th class="px-3 py-2 text-center text-xs font-medium text-gray-500 uppercase">К2</th>
					<th class="px-3 py-2 text-center text-xs font-medium text-gray-500 uppercase">К3</th>
					<th class="px-3 py-2 text-center text-xs font-medium text-gray-500 uppercase">Ал.</th>
					<th class="px-3 py-2 text-center text-xs font-medium text-gray-500 uppercase">Опрос</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, device := range devices {
					@DeviceRow(device)
				}
			</tbody>
		</table>
	</div>
}

templ DeviceRow(device model.Device) {
	<tr id={ fmt.Sprintf("device-row-%d", device.ID) }
		class="hover:bg-blue-50 cursor-pointer transition-colors duration-150"
		hx-get={ fmt.Sprintf("/devices/%d/details", device.ID) }
		hx-target="#deviceDetails"
		hx-swap="innerHTML">
		<td class="px-3 py-2 text-sm font-medium text-gray-900">{ device.IPAddress }</td>
		<td class="px-3 py-2 text-sm font-medium text-gray-900">{ device.MACAddress }</td>
		<td class="px-3 py-2 text-sm text-gray-700">
			if device.Name != "" {
				{ device.Name }
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-3 py-2 text-sm text-gray-700">
			if device.Location != "" {
				{ device.Location }
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-3 py-2 text-center">@ChannelBadge(device, 1)</td>
		<td class="px-3 py-2 text-center">@ChannelBadge(device, 2)</td>
		<td class="px-3 py-2 text-center">@ChannelBadge(device, 3)</td>
		<td class="px-3 py-2 text-center">
			if presenter.NewDevicePresenter(&device).HasAlarms() {
				<span class="inline-block w-2 h-2 rounded-full bg-red-500" title="Есть алармы"></span>
			} else {
				<span class="inline-block w-2 h-2 rounded-full bg-green-500" title="Нет алармов"></span>
			}
		</td>
		<td class="px-3 py-2 text-center" onclick="event.stopPropagation()">
			if presenter.NewDevicePresenter(&device).CanPoll() {
				<button class="text-blue-600 hover:text-blue-800"
						hx-post={ fmt.Sprintf("/devices/%d/poll", device.ID) }
						hx-target={ fmt.Sprintf("#device-row-%d", device.ID) }
						hx-swap="outerHTML"
						title="Опросить устройство">
					<img src="/static/icons/refresh.svg" class="w-4 h-4 inline" alt="Опрос"/>
				</button>
			} else {
				<button class="text-gray-400 cursor-not-allowed"
						disabled
						title={ "Следующий опрос через " + presenter.NewDevicePresenter(&device).FormatTimeUntilNextPoll() }>
					<img src="/static/icons/refresh.svg" class="w-4 h-4 inline opacity-50" alt="Ожидание"/>
				</button>
			}
		</td>
	</tr>
}

templ ChannelBadge(device model.Device, channelNum int) {
	<span class={ "inline-block w-3 h-3 rounded-full " + presenter.NewDevicePresenter(&device).GetChannel(channelNum).BadgeColor() }
		  title={ "Канал " + fmt.Sprintf("%d", channelNum) + ": " + presenter.NewDevicePresenter(&device).GetChannel(channelNum).StateString() }></span>
}
