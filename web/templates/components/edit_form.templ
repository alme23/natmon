package components

import (
	"fmt"
	"github.com/alme23/natmon/internal/model"
)

templ EditDeviceForm(device model.Device) {
	<div class="flex justify-between items-center mb-4">
		<h3 class="text-lg font-medium">Редактировать устройство</h3>
		<button onclick="document.getElementById('editModal').classList.add('hidden')" class="text-gray-400">
			<img src="/static/icons/close.svg" class="w-6 h-6" alt="Закрыть"/>
		</button>
	</div>

	<form hx-post={ fmt.Sprintf("/devices/%d/update", device.ID) }
		  hx-target={ fmt.Sprintf("#device-row-%d", device.ID) }
		  hx-swap="outerHTML"
		  hx-on::after-request="if(event.detail.successful) { document.getElementById('editModal').classList.add('hidden'); }">
		<div class="mb-4">
			<label class="block text-sm font-medium mb-2">IP адрес</label>
			<input type="text" name="ip_address" value={ device.IPAddress } required
				   pattern="^(\d{1,3}\.){3}\d{1,3}$"
				   class="mt-1 block w-full rounded-md border-gray-300 px-3 py-2"/>
		</div>
		<div class="mb-4">
			<label class="block text-sm font-medium mb-2">SNMP Port</label>
			<input type="number" name="snmp_port" value={ fmt.Sprintf("%d", device.SNMPPort) }
				   class="mt-1 block w-full rounded-md border-gray-300 px-3 py-2"/>
		</div>
		<div class="mb-4">
			<label class="block text-sm font-medium mb-2">Community</label>
			<input type="text" name="snmp_community" value={ device.SNMPCommunity }
				   class="mt-1 block w-full rounded-md border-gray-300 px-3 py-2"/>
		</div>
		<div class="flex justify-end space-x-3">
			<button type="button" onclick="document.getElementById('editModal').classList.add('hidden')"
					class="px-4 py-2 text-sm text-gray-700 bg-white border rounded-md">
				Отмена
			</button>
			<button type="submit"
					class="px-4 py-2 text-sm text-white bg-blue-600 rounded-md">
				Сохранить
			</button>
		</div>
	</form>
}
