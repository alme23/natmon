package model

import (
	"net/netip"
)

type Device struct {
	// Поля, задаваемые пользователем
	ipAddress       netip.Addr // IP адрес устройства, хранится в таблице "devices"
	snmpPort        uint16     // Порт SNMP, по-умолчанию 161, хранится в таблице "devices"
	snmpRwCommunity string     // Имя RW community, по-умолчанию "private", хранится в таблице "devices"
	snmpVersion     uint8      // Версия SNMP, по-умолчанию 1, хранится в таблице "devices"

	// Поля, получаемые через SNMP

	// MIB-2
	name     string `oid:".1.3.6.1.2.1.1.5.0"`
	location string `oid:".1.3.6.1.2.1.1.6.0"`
	contact  string `oid:".1.3.6.1.2.1.1.4.0"`

	// enterprise
	deviceMetrics  deviceMetrics
	deviceAlarms   deviceAlarms
	channelsStatus [3]channelStatus
}

type deviceMetrics struct {
	RadioOutputEnabled RadioOutputStatus `oid:".1.3.6.1.4.1.4249.1.31.3.1.2.0"`
	Termperature       string            `oid:".1.3.6.1.4.1.4249.1.31.3.1.3.0"`
	InternalPower1     string            `oid:".1.3.6.1.4.1.4249.1.31.3.1.4.0"`
	InternalPower2     string            `oid:".1.3.6.1.4.1.4249.1.31.3.1.5.0"`
}

type RadioOutputStatus int

const (
	RadioOutputStatusOff RadioOutputStatus = iota
	RadioOutputStatusOn
	RadioOutputStatusOffTemperatureLimit
	RadioOutputStatusOffTemperatureHyst
	RadioOutputStatusOffPowerUpLimit
	RadioOutputStatusOffPowerBottmomLimit
	RadioOutputStatusOffPowerPause
	RadioOutputStatusOffProtectionMinor
	RadioOutputStatusOffProtectionMajor
	RadioOutputStatusOffProtectionPause
)

type deviceAlarms struct {
	EthLos               OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.1.0"`
	Shortcut             OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.2.0"`
	PowerUpLimit         OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.3.0"`
	PowerBottomLimit     OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.4.0"`
	TemperatureLimit     OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.5.0"`
	Channel1NotConnected OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.6.0"`
	Channel2NotConnected OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.7.0"`
	Channel3NotConnected OffOnType `oid:".1.3.6.1.4.1.4249.1.31.3.3.8.0"`
}

type OffOnType int

const (
	Off OffOnType = iota
	On
)

type channelStatus struct {
	ChannelStatusId        int                    `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.1.[1...3]"`
	ChannelStatusStateLink ChannelStatusStateLink `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.2.[1...3]"`
	ChannelStatusStream    string                 `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.3.[1...3]"`
	ChannelStatusServer    string                 `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.4.[1...3]"`
	// ChannelStatusMetainterval int                    `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.5.[1...3]"`
	// ChannelStatusBitrate      int                    `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.6.[1...3]"`
	// ChannelStatusSamplerate   int                    `oid:".1.3.6.1.4.1.4249.1.31.3.1.1.7.[1...3]"`
}

type ChannelStatusStateLink int

const (
	ChannelStatusStateLinkOff ChannelStatusStateLink = iota
	ChannelStatusStateLinkToBeStopped
	ChannelStatusStateLinkStarting
	ChannelStatusStateLinkStarted
	ChannelStatusStateLinkConnected
	ChannelStatusStateLinkReconnecting
)

func (d *Device) Address() netip.Addr { return d.ipAddress }
func (d *Device) Port() uint16        { return d.snmpPort }
func (d *Device) Community() string   { return d.snmpRwCommunity }
func (d *Device) Version() uint8      { return d.snmpVersion }
